      "@testing-library/svelte": "^5.2.8",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^22.18.10",
      "@types/pg": "^8.15.5",
		"@types/swagger-ui": "^3.52.4",
      "@vitest/ui": "^3.2.4",
      "autoprefixer": "^10.4.21",
